# Real Capita ERP live-demo production template.
# Copy this file to .env on the remote server, then replace every placeholder.

# Compose
COMPOSE_PROJECT_NAME=real-capita-erp-production
COMPOSE_FILE=compose.production.yaml

# Public DNS and TLS
PUBLIC_APP_HOST=erp.example.com
PUBLIC_STORAGE_HOST=files.erp.example.com
ACME_EMAIL=ops@example.com

# Shared application metadata
APP_NAME=Real Capita ERP
NODE_ENV=production

# Frontend public URLs
NEXT_PUBLIC_APP_URL=https://erp.example.com
NEXT_PUBLIC_API_BASE_URL=https://erp.example.com

# Backend application URLs
WEB_APP_URL=https://erp.example.com
API_BASE_URL=https://erp.example.com
CORS_ORIGIN=https://erp.example.com

# Backend routing and docs
API_GLOBAL_PREFIX=api
API_VERSION=1
ENABLE_SWAGGER=false
SWAGGER_PATH=api/docs
API_PORT=3333

# Database
POSTGRES_DB=real_capita_erp
POSTGRES_USER=real_capita_app
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://real_capita_app:replace-with-a-strong-postgres-password@127.0.0.1:5432/real_capita_erp?schema=public

# Auth
JWT_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters-access
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_SECRET=replace-with-at-least-32-random-characters-refresh
JWT_REFRESH_TOKEN_TTL=7d

# Object storage
MINIO_ROOT_USER=replace-with-minio-admin-user
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-root-password
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://files.erp.example.com
S3_REGION=us-east-1
S3_BUCKET=real-capita-erp-demo
S3_ACCESS_KEY=replace-with-minio-admin-user
S3_SECRET_KEY=replace-with-a-strong-minio-root-password
S3_FORCE_PATH_STYLE=true
